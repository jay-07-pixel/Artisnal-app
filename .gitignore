# ------------------------------------------------------------------ Flutter ---
# Build output and tool caches. These are ~3.8 GB here and are regenerated by
# `flutter pub get` / `flutter build`, so they must never be committed.
artisanal_lens/build/
artisanal_lens/.dart_tool/
artisanal_lens/.flutter-plugins
artisanal_lens/.flutter-plugins-dependencies
artisanal_lens/.packages
artisanal_lens/.pub-cache/
artisanal_lens/.pub/
artisanal_lens/coverage/
**/doc/api/
*.dart_tool/
.flutter-versions

# pubspec.lock IS committed: this is an application, not a package, so pinning
# exact dependency versions is what makes a build reproducible.

# ------------------------------------------------------------------ Android ---
artisanal_lens/android/.gradle/
artisanal_lens/android/captures/
artisanal_lens/android/local.properties
artisanal_lens/android/app/debug/
artisanal_lens/android/app/profile/
artisanal_lens/android/app/release/
artisanal_lens/android/.cxx/
*.jks
*.keystore
key.properties

# ---------------------------------------------------------------------- iOS ---
artisanal_lens/ios/Pods/
artisanal_lens/ios/.symlinks/
artisanal_lens/ios/Flutter/Flutter.framework
artisanal_lens/ios/Flutter/Flutter.podspec
artisanal_lens/ios/Flutter/Generated.xcconfig
artisanal_lens/ios/Flutter/flutter_export_environment.sh
artisanal_lens/ios/Runner/GeneratedPluginRegistrant.*
**/*.mode1v3
**/*.mode2v3
**/*.perspectivev3
**/xcuserdata/

# ---------------------------------------------------------------------- Web ---
# sqlite3.wasm and sqflite_sw.js are generated by
#   dart run sqflite_common_ffi_web:setup
# and are ~1 MB of vendored binary, so they are fetched rather than committed.
artisanal_lens/web/sqlite3.wasm
artisanal_lens/web/sqflite_sw.js

# ------------------------------------------------------------------ Desktop ---
artisanal_lens/linux/flutter/ephemeral/
artisanal_lens/macos/Flutter/ephemeral/
artisanal_lens/windows/flutter/ephemeral/

# ------------------------------------------------------------------- Editors ---
.idea/
.vscode/
*.iml
*.ipr
*.iws
.history/
*.swp

# --------------------------------------------------------------------- OS ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ------------------------------------------------------------------- Source ---
# The 20 MB BTP report is the same document as the -compressed copy that is
# committed under docs/. Excluded so every clone does not carry it twice.
BTP_210205009_210205031 (2).pdf

# Empty scratch folder from the original working directory.
info/

# Local env overrides (optional). Supabase anon keys are committed for team runs.
.env
**/.env
!**/.env.example

# Emulator screenshots taken while checking live camera guidance by hand.
.shots/
*.log

# Local release binaries and scratch media — never commit these.
*.apk
*.mp4
analyze_out.txt
